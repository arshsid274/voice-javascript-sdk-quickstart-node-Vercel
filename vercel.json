{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/token",
      "methods": ["GET"],
      "dest": "index.js"
    },
    {
      "src": "/voice",
      "methods": ["POST"],
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
